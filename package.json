{
  "name": "beltorganics",
  "version": "0.2.0",
  "description": "A factory-style game with an organic-chemistry-inspired pseudo-chemistry: convey molecules on belts, react them in chambers, and separate products from stochastic side reactions.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "graphology": "^0.26.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "graphology-types": "^0.24.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
